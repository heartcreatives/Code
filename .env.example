# Copy to .env.local and fill in from your Supabase project settings (API section).
# Only the ANON key belongs in a client app. Never put the service-role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: set to "true" to show the "Load sample data" button on the dashboard.
VITE_ENABLE_SEED=false
